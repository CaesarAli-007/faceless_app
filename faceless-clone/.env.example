# --- App ---
DATABASE_URL="file:../data/app.db"
APP_SECRET="change-me-to-a-long-random-string"
PUBLIC_BASE_URL=""                     # optional tunnel URL, needed only for Instagram
STORAGE_DIR="./storage"
WORKER_CONCURRENCY=1
IMAGE_CONCURRENCY=2

# --- Script (LLM) ---
SCRIPT_PROVIDER="anthropic"            # anthropic | openai | ollama | builtin
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"    # use any current Claude model id
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# --- Images ---
IMAGE_PROVIDER="commons"               # commons | comfyui | a1111 | fal | replicate | openai | placeholder
COMFYUI_URL="http://127.0.0.1:8188"
COMFYUI_CHECKPOINT="v1-5-pruned-emaonly.safetensors"
A1111_URL="http://127.0.0.1:7860"
FAL_KEY=""
REPLICATE_API_TOKEN=""

# --- TTS ---
TTS_PROVIDER="edge"                    # edge | kokoro | elevenlabs
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL="eleven_multilingual_v2"
KOKORO_URL="http://127.0.0.1:8880"

# --- Captions ---
WHISPER_MODEL="base.en"
WHISPER_CPP_PATH=""                    # optional path to whisper-cli / main binary

# --- Social ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
PUBLISH_DRY_RUN="true"

# Optional. Remotion uses system Chrome when this is set or when Chrome is on PATH.
REMOTION_BROWSER_EXECUTABLE=""
